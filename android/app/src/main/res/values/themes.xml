<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_background">#10151F</color>
    <!-- Dark from the first frame, so there is no white flash before the game draws. -->
    <style name="Theme.WonderLot" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28" xmlns:tools="http://schemas.android.com/tools">shortEdges</item>
    </style>
</resources>
